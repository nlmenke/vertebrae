{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nlmenke/vertebrae",
    "type": "project",
    "description": "Backbone for personal projects.",
    "keywords": [
        "laravel",
        "skeleton",
        "starter-kit"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "inertiajs/inertia-laravel": "^3.5.1",
        "laravel/fortify": "^1.40.0",
        "laravel/framework": "^13.34",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "^0.1.21",
        "league/flysystem-aws-s3-v3": "^3.35.3"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.11",
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.12.2",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.68",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.0",
        "pestphp/pest-plugin-browser": "^5.1.2",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.2.2",
        "pestphp/pest-plugin-type-coverage": "^5.0.2",
        "phpstan/phpstan-mockery": "^2.0"
    },
    "autoload": {
        "classmap": [
            "database/migrations/"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:dependencies"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build",
            "npx playwright install",
            "@test:all"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:all": [
            "Composer\\Config::disableProcessTimeout",
            "npm run test:format",
            "npm run test:lint",
            "@test"
        ],
        "test:lint": [
            "rector --dry-run",
            "pint --parallel --test"
        ],
        "test:type-coverage": "pest --parallel --type-coverage --min=100",
        "test:types": "phpstan",
        "test:unit": "pest --parallel --coverage --exactly=100",
        "test": [
            "@php artisan config:clear --ansi",
            "@test:type-coverage",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ],
        "update:dependencies": [
            "composer bump",
            "npx npm-check-updates --target semver -u"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
